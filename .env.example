# GitLab Configuration
GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=your_gitlab_token_here
GITLAB_PROJECT_ID=12345

# SOCKS5 Proxy Configuration (for GitLab access)
SOCKS5_PROXY_HOST=127.0.0.1
SOCKS5_PROXY_PORT=1080

# GitHub Configuration
GITHUB_TOKEN=your_github_token_here
GITHUB_OWNER=your-github-username
GITHUB_REPO=your-repo-name

# Migration Options
# Directory to store fetched GitLab data
DATA_DIR=data
# Whether to include closed issues (true/false)
INCLUDE_CLOSED_ISSUES=true
# Whether to preserve issue labels (true/false)
PRESERVE_LABELS=true
# Whether to add a note indicating the issue was migrated (true/false)
ADD_MIGRATION_NOTE=true
