# GitLab Configuration
GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=your_gitlab_token_here
GITLAB_PROJECT_ID=12345
# SSL verification: false to disable (for self-signed certs), true to enable, or path to CA bundle
GITLAB_SSL_VERIFY=false

# SOCKS5 Proxy Configuration (for GitLab access)
SOCKS5_PROXY_HOST=127.0.0.1
SOCKS5_PROXY_PORT=1080
# Optional: Leave empty if no authentication required
SOCKS5_PROXY_USER=
SOCKS5_PROXY_PASS=

# GitHub Configuration
GITHUB_TOKEN=your_github_token_here
GITHUB_OWNER=your-github-username
GITHUB_REPO=your-repo-name

# Migration Options
# Directory to store fetched GitLab data
DATA_DIR=data
# Whether to include closed issues (true/false)
INCLUDE_CLOSED_ISSUES=true
# Whether to preserve issue labels (true/false)
PRESERVE_LABELS=true
# Whether to add a note indicating the issue was migrated (true/false)
ADD_MIGRATION_NOTE=true
# Whether to download and migrate images (true/false)
# NOTE: GitLab uploads require session authentication which API tokens don't provide.
# Set to false to skip image downloads (images will keep original GitLab URLs).
MIGRATE_IMAGES=false
# Directory in GitHub repo to store migrated images
GITHUB_IMAGES_PATH=migrated-images
